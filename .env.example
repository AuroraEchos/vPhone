# Copy this file to .env and set the credential for your chosen endpoint.
# This example endpoint must support image_url input and function tool calls.
API_KEY=
VPHONE_MODEL_BASE_URL=https://api.deepseek.com
VPHONE_MODEL_ID=deepseek-flash
VPHONE_MODEL_TIMEOUT_SECONDS=90
VPHONE_MODEL_MAX_OUTPUT_TOKENS=4096
VPHONE_MODEL_IMAGE_DETAIL=original
# Optional; remove or leave blank if the endpoint does not support this parameter.
VPHONE_MODEL_REASONING_EFFORT=high

# Optional per-task run limits.
VPHONE_MAX_ACTIONS=12
VPHONE_MAX_SECONDS=600
VPHONE_SETTLE_SECONDS=0.5
# VPHONE_DEVICE_ID=
